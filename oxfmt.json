{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortPackageJson": true,
  "sortImports": {
    "newlinesBetween": true,
    "groups": [
      "value-builtin",
      "value-external",
      [
        "value-internal",
        "type-internal"
      ],
      [
        "value-parent",
        "type-parent"
      ],
      [
        "value-sibling",
        "type-sibling"
      ],
      [
        "value-index",
        "type-index"
      ],
      "type-import",
      "unknown"
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/generated/**"
  ]
}

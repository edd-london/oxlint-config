{
  "name": "@eddlondon/oxlint-config",
  "version": "1.0.0",
  "description": "EDD London's shared oxlint and oxfmt configuration: the oxlint version of @eddlondon/eslint-config-react.",
  "type": "module",
  "exports": {
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./base.json": "./base.json",
    "./react.json": "./react.json",
    "./oxfmt.json": "./oxfmt.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "base.json",
    "react.json",
    "oxfmt.json",
    "README.md"
  ],
  "keywords": [
    "oxlint",
    "oxfmt",
    "oxc",
    "config",
    "EDD London"
  ],
  "author": {
    "name": "EDD London"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/edd-london/oxlint-config.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate-json.mjs",
    "lint": "oxlint -c base.json src scripts test.js",
    "format": "oxfmt -c oxfmt.json src scripts test.js fixtures/pass",
    "format:check": "oxfmt -c oxfmt.json --check src scripts test.js fixtures/pass",
    "test": "npm run build && node test.js",
    "prepublishOnly": "npm test",
    "push": "npm version patch && git push --follow-tags",
    "push-patch": "npm version patch --force && git push --follow-tags",
    "push-minor": "npm version minor && git push --follow-tags",
    "push-major": "npm version major && git push --follow-tags"
  },
  "peerDependencies": {
    "oxfmt": ">=0.72.0",
    "oxlint": ">=1.87.0",
    "oxlint-tsgolint": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
